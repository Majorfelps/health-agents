# Copie para .env e ajuste conforme necessário

# API
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health_agents
DEBUG=false
SECRET_KEY=change-me-in-production-32-chars-min
CORS_ORIGINS=["http://localhost:3000"]

# Web (NEXT_PUBLIC_API_URL é exposto ao browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM opcional (OpenRouter — https://openrouter.ai/models).
# OPENROUTER_API_KEY é a única coisa que fica só no .env (segurança).
# LLM_ENABLED/OPENROUTER_MODEL aqui são só o valor inicial — depois que o
# app sobe, ligar/desligar e trocar de modelo é feito pela própria
# aplicação (tela "IA" no web, ou PUT /api/v1/llm/config), sem editar
# .env nem reiniciar nada. Ver README § "Integração com LLM".
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# WhatsApp opcional (Evolution API) — espelha as respostas do chat web
# também pro WhatsApp. EVOLUTION_API_KEY/URL/INSTANCE ficam só no .env
# (infra + segredo). WHATSAPP_ENABLED/WHATSAPP_TARGET_NUMBER aqui são só
# o valor inicial — depois liga/desliga e troca o número pela própria
# aplicação (tela "IA" no web, ou PUT /api/v1/whatsapp/config).
WHATSAPP_ENABLED=false
WHATSAPP_TARGET_NUMBER=
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Copie para .env e ajuste conforme necessário

# API
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health_agents
DEBUG=false
SECRET_KEY=change-me-in-production-32-chars-min
CORS_ORIGINS=["http://localhost:3000"]

# Web (NEXT_PUBLIC_API_URL é exposto ao browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM opcional (OpenRouter — https://openrouter.ai/models).
# OPENROUTER_API_KEY é a única coisa que fica só no .env (segurança).
# LLM_ENABLED/OPENROUTER_MODEL aqui são só o valor inicial — depois que o
# app sobe, ligar/desligar e trocar de modelo é feito pela própria
# aplicação (tela "IA" no web, ou PUT /api/v1/llm/config), sem editar
# .env nem reiniciar nada. Ver README § "Integração com LLM".
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Copie para .env e ajuste conforme necessário

# API
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health_agents
DEBUG=false
SECRET_KEY=change-me-in-production-32-chars-min
CORS_ORIGINS=["http://localhost:3000"]

# Web (NEXT_PUBLIC_API_URL é exposto ao browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM opcional (OpenRouter — https://openrouter.ai/models). Deixe
# LLM_ENABLED=false (ou OPENROUTER_API_KEY/OPENROUTER_MODEL vazios) pra
# manter o chat 100% determinístico e offline, como já era antes.
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
